# Optional override for the built-in OAuth application.
# OAuth login works without this file; set these only to use your own AtomGit
# OAuth application instead. Its callback must be
# http://127.0.0.1:59058/api/dsh-atomgit-panel/oauth/callback
DSH_ATOMGIT_OAUTH_CLIENT_ID=
DSH_ATOMGIT_OAUTH_CLIENT_SECRET=
